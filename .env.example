NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for Admin → People (create/edit/delete users). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional — set `true` on Vercel to allow @example.com demo accounts in production (see docs/DEMO_USERS.md)
ALLOW_DEV_EMAIL_DOMAIN=

# Optional — label in authenticator apps during MFA enrollment (defaults to SailPoint SE Enablement)
NEXT_PUBLIC_MFA_ISSUER=

# AI provider configuration. Defaults to xAI when XAI_API_KEY is present.
AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-3-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only — encrypts AI keys before they are written to Supabase (generate: openssl rand -base64 32)
PLATFORM_SECRETS_ENCRYPTION_KEY=

NEXT_PUBLIC_SSO_DOMAIN=sailpoint.com
CRON_SECRET=
RESEND_API_KEY=
DIGEST_FROM_EMAIL=onboarding@resend.dev

# UAT bug tracker (Forge) — server-only; never expose to the browser
FORGE_API_KEY=
FORGE_API_BASE_URL=https://forge-nu-ochre.vercel.app
FORGE_PROJECT_KEY=SEENA
FORGE_ASSIGNEE_EMAIL=matt.j.giblin@gmail.com
FORGE_ASSIGNEE_NAME=Matt Giblin
FORGE_DEFAULT_STATUS=backlog
# Optional: set if members API lookup fails (UUID from Forge project members)
FORGE_ASSIGNEE_ID=

# Browser SDK — auto-capture uncaught JS errors + ~45s session replay (issues:write scope only)
# Create in Forge Admin → Integrations → API Keys. Safe to expose (write-only).
NEXT_PUBLIC_FORGE_SDK_API_KEY=
# Optional; defaults to FORGE_API_BASE_URL
NEXT_PUBLIC_FORGE_API_BASE_URL=
NEXT_PUBLIC_FORGE_SDK_ENVIRONMENT=uat
